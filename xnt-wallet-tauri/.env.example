# Copy this file to .env for development. All values are required.

# xnt-core JSON-RPC endpoint (Node, Chain, Archival, Mempool modules). The bridge relayer is
# reached on the same origin under /bridge/deposits/.
VITE_APP_API=https://leviathandev.neptune.io/xnt-rpc

# Block explorer opened from History rows (<url>/utxo/<commitment>).
VITE_EXPLORER_URL=http://178.63.134.75:4080

# Leviathan (Miden) explorer for WXNT mint txs and notes (<url>/tx/<id>, <url>/note/<id>).
VITE_LEVIATHAN_EXPLORER_URL=https://leviathandev.neptune.io

# XNT price ticker (CoinMarketCap lite detail; mainnet XNT price, shown on testnet too).
VITE_PRICE_URL=https://api.coinmarketcap.com/data-api/v3/cryptocurrency/detail/lite?id=39109

# Address format: mainnet or testnet.
VITE_NODE_NETWORK=testnet

# Local release-signing secrets — copy this file to `.env.signing` and fill in.
#
#   cp .env.signing.example .env.signing
#
# `.env.signing` is gitignored; NEVER commit real passwords. It is auto-loaded by
# scripts/sign-release.sh (and therefore scripts/build-android.sh). Quote the
# values — signing passwords often contain characters like '#' that the shell
# would otherwise treat as a comment.

export STOREPASS='your-upload-keystore-password'
export KEYPASS='your-upload-key-password'

# Optional overrides (defaults are fine for the standard setup):
# export KEYSTORE="$PWD/upload-keystore.jks"
# export KEYALIAS='upload'
